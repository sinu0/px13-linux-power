diff --git a/rog-control-center/src/ui/setup_nvidia_tuning.rs b/rog-control-center/src/ui/setup_nvidia_tuning.rs
new file mode 100644
index 00000000..cd563dbf
--- /dev/null
+++ b/rog-control-center/src/ui/setup_nvidia_tuning.rs
@@ -0,0 +1,454 @@
+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+use log::{debug, warn};
+use serde::Deserialize;
+use slint::{ComponentHandle, SharedString};
+
+use crate::{AttrMinMax, GPUPageData, MainWindow, SystemPageData};
+
+// Optional provider API. The provider owns model-specific safety policy while
+// the UI renders only its advertised profiles and hardware limits.
+const SERVICE: &str = "org.asuslinux.Px13Power";
+const PATH: &str = "/org/asuslinux/Px13Power";
+const INTERFACE: &str = "org.asuslinux.Px13Power";
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct ValueRange {
+    min: i32,
+    max: i32,
+    #[serde(default = "default_step")]
+    step: i32,
+}
+
+fn default_step() -> i32 {
+    1
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct PowerCapabilities {
+    available: bool,
+    base_power: ValueRange,
+    dynamic_boost: ValueRange,
+    temperature_target: ValueRange,
+    max_total: i32,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct ClockCapabilities {
+    core_offset: ValueRange,
+    memory_offset: ValueRange,
+    clock_limit: ValueRange,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct CpuPowerCapabilities {
+    available: bool,
+    sustained: ValueRange,
+    slow: ValueRange,
+    fast: ValueRange,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+struct TuningCapabilities {
+    provider: String,
+    profiles: Vec<String>,
+    #[serde(default)]
+    requires_cooling_confirmation: bool,
+    #[serde(default)]
+    power: PowerCapabilities,
+    #[serde(default)]
+    cpu_power: CpuPowerCapabilities,
+    #[serde(default)]
+    clocks: ClockCapabilities,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct GpuOffsets {
+    #[serde(default)]
+    core_mhz: i32,
+    #[serde(default)]
+    memory_mhz: i32,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct NvpcfState {
+    #[serde(default)]
+    base_tgp_w: i32,
+    #[serde(default)]
+    dynamic_boost_w: i32,
+    #[serde(default)]
+    max_tgp_w: i32,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct Telemetry {
+    #[serde(default)]
+    gpu_power_w: Option<f32>,
+    #[serde(default)]
+    gpu_temperature_c: Option<f32>,
+    #[serde(default)]
+    gpu_clock_mhz: Option<f32>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+struct TuningState {
+    active_profile: String,
+    ac_online: bool,
+    lid_open: bool,
+    cooling_confirmed: bool,
+    #[serde(default)]
+    last_error: String,
+    #[serde(default)]
+    gpu_offsets: GpuOffsets,
+    #[serde(default)]
+    gpu_clock_limit_mhz: i32,
+    #[serde(default)]
+    nvpcf_override: NvpcfState,
+    #[serde(default)]
+    telemetry: Telemetry,
+    #[serde(default)]
+    wmi: BTreeMap<String, String>,
+}
+
+fn decode<T: for<'de> Deserialize<'de>>(raw: String) -> zbus::Result<T> {
+    serde_json::from_str(&raw).map_err(|error| zbus::Error::Failure(error.to_string()))
+}
+
+fn apply_capabilities(ui: &MainWindow, caps: &TuningCapabilities) {
+    let global = ui.global::<GPUPageData>();
+    let profiles: Vec<SharedString> = caps.profiles.iter().map(SharedString::from).collect();
+
+    global.set_driver_tuning_available(true);
+    global.set_driver_provider(SharedString::from(if caps.provider.is_empty() {
+        "NVIDIA Driver Tuning"
+    } else {
+        caps.provider.as_str()
+    }));
+    global.set_driver_profiles(profiles.as_slice().into());
+    global.set_driver_requires_cooling_confirmation(caps.requires_cooling_confirmation);
+    global.set_driver_power_available(caps.power.available);
+    global.set_driver_power_base_min(caps.power.base_power.min);
+    global.set_driver_power_base_max(caps.power.base_power.max);
+    global.set_driver_boost_min(caps.power.dynamic_boost.min);
+    global.set_driver_boost_max(caps.power.dynamic_boost.max);
+    global.set_driver_temp_min(caps.power.temperature_target.min);
+    global.set_driver_temp_max(caps.power.temperature_target.max);
+    global.set_driver_power_max_total(caps.power.max_total);
+    global.set_driver_core_min(caps.clocks.core_offset.min);
+    global.set_driver_core_max(caps.clocks.core_offset.max);
+    global.set_driver_memory_min(caps.clocks.memory_offset.min);
+    global.set_driver_memory_max(caps.clocks.memory_offset.max);
+    global.set_driver_clock_min(caps.clocks.clock_limit.min);
+    global.set_driver_clock_max(caps.clocks.clock_limit.max);
+    global.set_driver_clock_step(caps.clocks.clock_limit.step.max(1));
+
+    let system = ui.global::<SystemPageData>();
+    let standard_cpu_power_available = system.get_ppt_pl1_spl().current >= 0.0
+        || system.get_ppt_pl2_sppt().current >= 0.0
+        || system.get_ppt_pl3_fppt().current >= 0.0;
+    let use_provider = caps.cpu_power.available && !standard_cpu_power_available;
+    global.set_driver_cpu_power_available(use_provider);
+    system.set_cpu_power_provider_available(use_provider);
+    if use_provider {
+        system.set_ppt_pl1_spl(AttrMinMax {
+            min: caps.cpu_power.sustained.min,
+            max: caps.cpu_power.sustained.max,
+            current: caps.cpu_power.sustained.min as f32,
+        });
+        system.set_ppt_pl2_sppt(AttrMinMax {
+            min: caps.cpu_power.slow.min,
+            max: caps.cpu_power.slow.max,
+            current: caps.cpu_power.slow.min as f32,
+        });
+        system.set_ppt_pl3_fppt(AttrMinMax {
+            min: caps.cpu_power.fast.min,
+            max: caps.cpu_power.fast.max,
+            current: caps.cpu_power.fast.min as f32,
+        });
+    }
+}
+
+fn parse_wmi(state: &TuningState, key: &str) -> Option<i32> {
+    state.wmi.get(key)?.parse().ok()
+}
+
+fn apply_state(ui: &MainWindow, state: TuningState, profiles: &[String]) {
+    let global = ui.global::<GPUPageData>();
+    if let Some(index) = profiles
+        .iter()
+        .position(|profile| profile == &state.active_profile)
+    {
+        global.set_driver_profile_index(index as i32);
+    }
+
+    let fallback_base =
+        parse_wmi(&state, "gpu_base_tgp").unwrap_or(0) + parse_wmi(&state, "gpu_tgp").unwrap_or(0);
+    let base = if state.nvpcf_override.base_tgp_w > 0 {
+        state.nvpcf_override.base_tgp_w
+    } else {
+        fallback_base
+    };
+    let boost = if state.nvpcf_override.dynamic_boost_w > 0 {
+        state.nvpcf_override.dynamic_boost_w
+    } else {
+        parse_wmi(&state, "gpu_dynamic_boost").unwrap_or(0)
+    };
+    let maximum = if state.nvpcf_override.max_tgp_w > 0 {
+        state.nvpcf_override.max_tgp_w
+    } else {
+        base + boost
+    };
+    let temperature_target = parse_wmi(&state, "gpu_thermal_target").unwrap_or(0);
+
+    global.set_driver_ac_online(state.ac_online);
+    global.set_driver_lid_open(state.lid_open);
+    global.set_driver_cooling_confirmed(state.cooling_confirmed);
+    global.set_driver_clocks_enabled(state.active_profile != "Safe");
+    global.set_driver_power_base(base as f32);
+    global.set_driver_boost(boost as f32);
+    global.set_driver_temp(temperature_target as f32);
+    global.set_driver_core(state.gpu_offsets.core_mhz as f32);
+    global.set_driver_memory(state.gpu_offsets.memory_mhz as f32);
+    global.set_driver_clock(state.gpu_clock_limit_mhz as f32);
+
+    if global.get_driver_cpu_power_available() {
+        let system = ui.global::<SystemPageData>();
+        system.set_cpu_power_provider_ready(
+            state.ac_online && state.lid_open && state.cooling_confirmed,
+        );
+        let mut sustained = system.get_ppt_pl1_spl();
+        let mut slow = system.get_ppt_pl2_sppt();
+        let mut fast = system.get_ppt_pl3_fppt();
+        sustained.current = parse_wmi(&state, "cpu_spl").unwrap_or(0) as f32;
+        slow.current = parse_wmi(&state, "cpu_sppt").unwrap_or(0) as f32;
+        fast.current = parse_wmi(&state, "cpu_fppt").unwrap_or(0) as f32;
+        system.set_ppt_pl1_spl(sustained);
+        system.set_ppt_pl2_sppt(slow);
+        system.set_ppt_pl3_fppt(fast);
+    }
+
+    let status = if state.last_error.is_empty() {
+        let power = state
+            .telemetry
+            .gpu_power_w
+            .map(|value| format!("{value:.1} W"))
+            .unwrap_or_else(|| "? W".to_string());
+        let temperature = state
+            .telemetry
+            .gpu_temperature_c
+            .map(|value| format!("{value:.0} C"))
+            .unwrap_or_else(|| "? C".to_string());
+        let clock = state
+            .telemetry
+            .gpu_clock_mhz
+            .map(|value| format!("{value:.0} MHz"))
+            .unwrap_or_else(|| "? MHz".to_string());
+        format!(
+            "{} | GPU {power}, {temperature}, {clock} | power {base}+{boost}={maximum} W",
+            state.active_profile
+        )
+    } else {
+        state.last_error
+    };
+    global.set_driver_status(SharedString::from(status));
+}
+
+fn report_result(
+    handle: slint::Weak<MainWindow>,
+    profiles: Arc<Vec<String>>,
+    context: &'static str,
+    result: zbus::Result<String>,
+) {
+    match result.and_then(decode::<TuningState>) {
+        Ok(state) => {
+            handle
+                .upgrade_in_event_loop(move |window| apply_state(&window, state, &profiles))
+                .ok();
+        }
+        Err(error) => {
+            handle
+                .upgrade_in_event_loop(move |window| {
+                    window
+                        .global::<GPUPageData>()
+                        .set_driver_status(SharedString::from(format!("{context}: {error}")));
+                })
+                .ok();
+        }
+    }
+}
+
+pub fn setup_nvidia_tuning(ui: &MainWindow) {
+    ui.global::<GPUPageData>()
+        .set_driver_tuning_available(false);
+    let handle = ui.as_weak();
+
+    tokio::spawn(async move {
+        let connection = match zbus::Connection::system().await {
+            Ok(connection) => connection,
+            Err(error) => {
+                debug!("GPU tuning provider unavailable: {error}");
+                return;
+            }
+        };
+        let proxy = match zbus::Proxy::new(&connection, SERVICE, PATH, INTERFACE).await {
+            Ok(proxy) => Arc::new(proxy),
+            Err(error) => {
+                debug!("GPU tuning provider unavailable: {error}");
+                return;
+            }
+        };
+
+        let caps = match proxy
+            .call::<_, _, String>("GetCapabilities", &())
+            .await
+            .and_then(decode::<TuningCapabilities>)
+        {
+            Ok(caps) if !caps.profiles.is_empty() => caps,
+            Ok(_) => {
+                warn!("GPU tuning provider returned no profiles");
+                return;
+            }
+            Err(error) => {
+                debug!("GPU tuning capabilities unavailable: {error}");
+                return;
+            }
+        };
+        let initial = match proxy
+            .call::<_, _, String>("GetState", &())
+            .await
+            .and_then(decode::<TuningState>)
+        {
+            Ok(state) => state,
+            Err(error) => {
+                warn!("GPU tuning provider state failed: {error}");
+                return;
+            }
+        };
+        let profiles = Arc::new(caps.profiles.clone());
+
+        let callback_proxy = proxy.clone();
+        let callback_handle = handle.clone();
+        let callback_profiles = profiles.clone();
+        handle
+            .upgrade_in_event_loop(move |window| {
+                apply_capabilities(&window, &caps);
+                apply_state(&window, initial, &callback_profiles);
+                let data = window.global::<GPUPageData>();
+                let clock_minimum = caps.clocks.clock_limit.min;
+                let clock_maximum = caps.clocks.clock_limit.max;
+                let clock_step = caps.clocks.clock_limit.step.max(1);
+
+                let confirm_proxy = callback_proxy.clone();
+                let confirm_handle = callback_handle.clone();
+                let confirm_profiles = callback_profiles.clone();
+                data.on_cb_driver_confirm_cooling(move || {
+                    let proxy = confirm_proxy.clone();
+                    let handle = confirm_handle.clone();
+                    let profiles = confirm_profiles.clone();
+                    tokio::spawn(async move {
+                        let result = proxy.call("ConfirmCooling", &()).await;
+                        report_result(handle, profiles, "Cooling confirmation failed", result);
+                    });
+                });
+
+                let activate_proxy = callback_proxy.clone();
+                let activate_handle = callback_handle.clone();
+                let activate_profiles = callback_profiles.clone();
+                data.on_cb_driver_activate(move |index| {
+                    let Some(profile) = activate_profiles.get(index as usize).cloned() else {
+                        return;
+                    };
+                    let proxy = activate_proxy.clone();
+                    let handle = activate_handle.clone();
+                    let profiles = activate_profiles.clone();
+                    tokio::spawn(async move {
+                        let result = proxy.call("Activate", &(profile,)).await;
+                        report_result(handle, profiles, "Profile change failed", result);
+                    });
+                });
+
+                let power_proxy = callback_proxy.clone();
+                let power_handle = callback_handle.clone();
+                let power_profiles = callback_profiles.clone();
+                data.on_cb_driver_set_power(move |base, boost, temperature| {
+                    let proxy = power_proxy.clone();
+                    let handle = power_handle.clone();
+                    let profiles = power_profiles.clone();
+                    tokio::spawn(async move {
+                        let result = proxy.call("SetGpuPower", &(base, boost, temperature)).await;
+                        report_result(handle, profiles, "GPU power change failed", result);
+                    });
+                });
+
+                if data.get_driver_cpu_power_available() {
+                    let cpu_proxy = callback_proxy.clone();
+                    let cpu_handle = callback_handle.clone();
+                    let cpu_profiles = callback_profiles.clone();
+                    window.global::<SystemPageData>().on_cb_cpu_power_provider(
+                        move |spl, sppt, fppt| {
+                            let proxy = cpu_proxy.clone();
+                            let handle = cpu_handle.clone();
+                            let profiles = cpu_profiles.clone();
+                            tokio::spawn(async move {
+                                let result = proxy.call("SetCpuPower", &(spl, sppt, fppt)).await;
+                                report_result(handle, profiles, "CPU power change failed", result);
+                            });
+                        },
+                    );
+                }
+
+                let offsets_proxy = callback_proxy.clone();
+                let offsets_handle = callback_handle.clone();
+                let offsets_profiles = callback_profiles.clone();
+                data.on_cb_driver_set_offsets(move |core, memory| {
+                    let proxy = offsets_proxy.clone();
+                    let handle = offsets_handle.clone();
+                    let profiles = offsets_profiles.clone();
+                    tokio::spawn(async move {
+                        let result = proxy.call("SetGpuOffsets", &(core, memory)).await;
+                        report_result(handle, profiles, "GPU clock offset failed", result);
+                    });
+                });
+
+                let clock_proxy = callback_proxy.clone();
+                let clock_handle = callback_handle.clone();
+                let clock_profiles = callback_profiles.clone();
+                data.on_cb_driver_set_clock(move |requested| {
+                    let proxy = clock_proxy.clone();
+                    let handle = clock_handle.clone();
+                    let profiles = clock_profiles.clone();
+                    let limit = if requested < clock_minimum {
+                        0
+                    } else {
+                        (((requested + clock_step / 2) / clock_step) * clock_step)
+                            .clamp(clock_minimum, clock_maximum)
+                    };
+                    tokio::spawn(async move {
+                        let result = proxy.call("SetGpuClockLimit", &(limit,)).await;
+                        report_result(handle, profiles, "GPU clock limit failed", result);
+                    });
+                });
+            })
+            .ok();
+
+        loop {
+            tokio::time::sleep(tokio::time::Duration::from_secs(2)).await;
+            match proxy
+                .call::<_, _, String>("GetState", &())
+                .await
+                .and_then(decode::<TuningState>)
+            {
+                Ok(state) => {
+                    let poll_profiles = profiles.clone();
+                    handle
+                        .upgrade_in_event_loop(move |window| {
+                            apply_state(&window, state, &poll_profiles)
+                        })
+                        .ok();
+                }
+                Err(error) => warn!("GPU tuning provider poll failed: {error}"),
+            }
+        }
+    });
+}
diff --git a/rog-control-center/src/ui/setup_system.rs b/rog-control-center/src/ui/setup_system.rs
index 3de07613..26e9500d 100644
--- a/rog-control-center/src/ui/setup_system.rs
+++ b/rog-control-center/src/ui/setup_system.rs
@@ -51,11 +51,16 @@ pub fn setup_system_page(ui: &MainWindow, _config: Arc<Mutex<Config>>) {
     ui.global::<SystemPageData>().set_ppt_apu_sppt(MINMAX);
     ui.global::<SystemPageData>().set_ppt_platform_sppt(MINMAX);
     ui.global::<SystemPageData>().set_nv_tgp(MINMAX);
+    ui.global::<SystemPageData>().set_nv_base_tgp(-1);
     ui.global::<SystemPageData>().set_nv_dynamic_boost(MINMAX);
     ui.global::<SystemPageData>().set_nv_temp_target(MINMAX);
     ui.global::<SystemPageData>().set_ppt_enabled(false);
     ui.global::<SystemPageData>()
         .set_ppt_enabled_available(false);
+    ui.global::<SystemPageData>()
+        .set_cpu_power_provider_available(false);
+    ui.global::<SystemPageData>()
+        .set_cpu_power_provider_ready(false);
 
     if let Ok(sys_props) = platform
         .supported_properties()
@@ -662,7 +667,10 @@ pub fn setup_system_page_callbacks(ui: &MainWindow, _states: Arc<Mutex<Config>>)
                                 setup_callback_restore_default!(nv_temp_target, handle, attr);
                                 setup_minmax_external!(nv_temp_target, handle, attr, platform);
                             }
-                            FirmwareAttribute::DgpuBaseTgp => {}
