# SPDX-License-Identifier: MIT
[Unit]
Description=Desktop notifications for px13-powerd warnings
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/lib/px13-powerd/px13_notify.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
