[Unit]
Description=Power profile controller for ASUS laptops (px13-linux-power)
After=asusd.service nvidia-powerd.service systemd-modules-load.service
Wants=asusd.service nvidia-powerd.service
# A package update can replace the modules of the still-running kernel.  Do
# not restart the controller into a broken state; the DKMS hook has already
# prepared the module for the kernel selected at the next boot.
ConditionPathExistsGlob=/usr/lib/modules/%v/updates/dkms/px13_tgp_probe.ko*
ConditionPathExists=/sys/module/px13_tgp_probe
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=dbus
BusName=org.asuslinux.TuningProvider
ExecStart=/usr/local/lib/px13-powerd/px13_powerd.py
Restart=on-failure
RestartSec=2
StateDirectory=px13-powerd
RuntimeDirectory=px13-powerd
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_OVERRIDE
PrivateTmp=true
PrivateIPC=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
IPAddressDeny=any
UMask=0077
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/sys/module/px13_tgp_probe/parameters /sys/devices/system/cpu/cpufreq /sys/devices/system/cpu/amd_pstate /var/lib/px13-powerd /run/px13-powerd

[Install]
WantedBy=multi-user.target
